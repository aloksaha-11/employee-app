<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Supplies Java 24, plugin and dependency version properties, and
         deployza-lib-lang, slf4j-api, logback-classic, lombok, junit-jupiter (test) -->
    <parent>
        <groupId>com.deployza</groupId>
        <artifactId>deployza-parent-pom</artifactId>
        <version>1.7-SNAPSHOT</version>
        <relativePath/>
    </parent>

    <groupId>com.employee</groupId>
    <artifactId>employee-app</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>war</packaging>
    <name>employee-app</name>

    <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.source>1.8</maven.compiler.source>
    <maven.compiler.target>1.8</mavn.compiler.target>
    <failOnMissingWebXml>false</failOnMissingWebXml>
    </properties>

    <!-- The parent must be resolvable before its own repositories are known -->
    <repositories>
        <repository>
            <id>private-snapshot-taiwan</id>
            <url>https://asia-east1-maven.pkg.dev/dz-builds/private-snapshot-taiwan</url>
            <releases>
                <enabled>false</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
    </repositories>

    <dependencies>
        <!-- Servlet API: supplied by the container at runtime -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <version>${jakarta-servlet-api.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>javax.servlet-api</artifactId>
            <version>4.0.1</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>employee-app</finalName>
        <plugins>
            <!-- Servlets are registered with @WebServlet, so no web.xml is required -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>${maven-war-plugin.version}</version>
                <configuration>
                    <failOnMissingWebXml>false</failOnMissingWebXml>
                </configuration>
            </plugin>

            <!-- Local run: mvn jetty:run -> http://localhost:8080/ -->
            <plugin>
                <groupId>org.eclipse.jetty.ee11</groupId>
                <artifactId>jetty-ee11-maven-plugin</artifactId>
                <version>${jetty-ee11-maven-plugin.version}</version>
            </plugin>
        </plugins>
    </build>
</project>
