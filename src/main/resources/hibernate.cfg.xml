<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">

<!-- The password is not kept here: EmployeeHibernateApi reads it from employee.properties,
     which lives outside the repository. -->
<hibernate-configuration>
    <session-factory>
        <property name="hibernate.connection.driver_class">com.mysql.cj.jdbc.Driver</property>
        <property name="hibernate.connection.url">jdbc:mysql://localhost:3306/employee</property>
        <property name="hibernate.connection.username">root</property>

        <!-- The employee table already exists; check the mapping against it, never alter it -->
        <property name="hibernate.hbm2ddl.auto">validate</property>

        <!-- Set to true to print the SQL Hibernate runs -->
        <property name="hibernate.show_sql">false</property>
        <property name="hibernate.format_sql">true</property>

        <mapping class="com.employee.EmployeePojo"/>
    </session-factory>
</hibernate-configuration>
