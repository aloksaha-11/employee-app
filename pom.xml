<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.employee</groupId>
    <artifactId>employee-app</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>war</packaging>
    <name>employee-app</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Must be your installed JDK version or lower (check with: java -version). Jetty 12.1 needs 17+ -->
        <maven.compiler.release>17</maven.compiler.release>
        <failOnMissingWebXml>false</failOnMissingWebXml>

        <jakarta-servlet-api.version>6.1.0</jakarta-servlet-api.version>
        <mysql-connector-j.version>26.7.0</mysql-connector-j.version>
        <log4j.version>2.26.1</log4j.version>
        <hibernate-core.version>7.4.11.Final</hibernate-core.version>
        <junit-jupiter.version>6.1.3</junit-jupiter.version>
        <maven-war-plugin.version>3.4.0</maven-war-plugin.version>
        <maven-surefire-plugin.version>3.6.0</maven-surefire-plugin.version>
        <jetty-ee11-maven-plugin.version>12.1.0</jetty-ee11-maven-plugin.version>
    </properties>

    <dependencies>
        <!-- Servlet API: supplied by the container at runtime -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <version>${jakarta-servlet-api.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- MySQL JDBC driver (successor to the retired mysql:mysql-connector-java) -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>${mysql-connector-j.version}</version>
        </dependency>

        <!-- Hibernate ORM (Jakarta Persistence) -->
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-core</artifactId>
            <version>${hibernate-core.version}</version>
        </dependency>

        <!-- Log4j 2 logging -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
            <version>${log4j.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>${log4j.version}</version>
        </dependency>

        <!-- JUnit 5+ (Jupiter) for tests -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit-jupiter.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>employee-app</finalName>
        <plugins>
            <!-- Servlets are registered with @WebServlet, so no web.xml is required -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>${maven-war-plugin.version}</version>
                <configuration>
                    <failOnMissingWebXml>false</failOnMissingWebXml>
                </configuration>
            </plugin>

            <!-- Runs JUnit Jupiter tests on mvn test -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
            </plugin>

            <!-- Local run: mvn jetty:run -> http://localhost:8081/employee-app/ (8080 is taken by a local Tomcat) -->
            <plugin>
                <groupId>org.eclipse.jetty.ee11</groupId>
                <artifactId>jetty-ee11-maven-plugin</artifactId>
                <version>${jetty-ee11-maven-plugin.version}</version>
                <configuration>
                    <httpConnector>
                        <port>8081</port>
                    </httpConnector>
                    <!-- Same context path as the WAR under Tomcat -->
                    <webApp>
                        <contextPath>/employee-app</contextPath>
                    </webApp>
                    <systemProperties>
                        <!-- Load logging config straight from source so edits apply on the next jetty:run -->
                        <log4j2.configurationFile>${project.basedir}/src/main/resources/log4j2.properties</log4j2.configurationFile>
                    </systemProperties>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
