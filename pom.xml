<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.employee</groupId>
    <artifactId>employee-app</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>war</packaging>
    <name>employee-app</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Must be your installed JDK version or lower (check with: java -version). Jetty 12.1 needs 17+ -->
        <maven.compiler.release>17</maven.compiler.release>
        <failOnMissingWebXml>false</failOnMissingWebXml>

        <jakarta-servlet-api.version>6.1.0</jakarta-servlet-api.version>
        <maven-war-plugin.version>3.4.0</maven-war-plugin.version>
        <jetty-ee11-maven-plugin.version>12.1.0</jetty-ee11-maven-plugin.version>
    </properties>

    <dependencies>
        <!-- Servlet API: supplied by the container at runtime -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <version>${jakarta-servlet-api.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>employee-app</finalName>
        <plugins>
            <!-- Servlets are registered with @WebServlet, so no web.xml is required -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>${maven-war-plugin.version}</version>
                <configuration>
                    <failOnMissingWebXml>false</failOnMissingWebXml>
                </configuration>
            </plugin>

            <!-- Local run: mvn jetty:run -> http://localhost:8080/ -->
            <plugin>
                <groupId>org.eclipse.jetty.ee11</groupId>
                <artifactId>jetty-ee11-maven-plugin</artifactId>
                <version>${jetty-ee11-maven-plugin.version}</version>
            </plugin>
        </plugins>
    </build>
</project>
